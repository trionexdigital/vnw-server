# Backend-only configuration. Copy to .env and provide your local values.
MYSQL_DB_HOST_IP=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=vipnumberworld
MYSQL_DB_USER=
MYSQL_DB_PASSWORD=
MYSQL_DB_CONN_COUNT=10
NODE_EXPRESS_PORT=3002
APP_NAME=vipnumberworld
APP_BASE_URL=http://localhost:5173
JWT_EXPIRY=900

# Cashfree Payment Gateway test environment. Never use VITE_ prefixes for keys.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_RETURN_BASE_URL=http://localhost:5173
# Public HTTPS API URL, including the complete route below:
# https://your-api-domain/vipnumberworld/payments/cashfree/webhook
CASHFREE_WEBHOOK_URL=

# Languages use bundled app catalogs and administrator-managed translations.
# No translation service credentials are required.

# Server-side GPS to PIN lookup; change provider without rebuilding the app.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=VIPNumberWorld/1.0 (https://vipnumberworld.com)
