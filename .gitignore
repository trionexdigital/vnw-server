# Dependencies and local caches
/node_modules/
/.cache/
**/__pycache__/
*.py[cod]

# Compiled output and compiler caches
/dist/
/out-tsc/
/tmp/
/bazel-out/
*.tsbuildinfo

# Generated verification output (keep test sources and SQL)
/output/
/coverage/
/test-results/
/playwright-report/
/blob-report/

# Runtime data and logs (never commit customer data)
/data/
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and host-specific deployment files
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
/deploy.sh
/pm2.json

# Profiling output
chrome-profiler-events*.json
speed-measure-plugin*.json

# Local editor/tool state and operating-system files
/.cla*
/.idea/
.project
.classpath
/.c9/
*.launch
/.settings/
*.sublime-workspace
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
/.history/
/.sass-cache/
/connect.lock
/typings/
.DS_Store
Thumbs.db
Desktop.ini
